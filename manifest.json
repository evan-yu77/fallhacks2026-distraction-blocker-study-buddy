{
  "manifest_version": 3,
  "name": "Digital Side-Kick",
  "version": "1.0",
  "description": "Your personal study assistant",

  "permissions": ["storage", "tabs"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["assets/mascot.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "chrome_url_overrides": {
  "newtab": "newtab.html"
}
}
